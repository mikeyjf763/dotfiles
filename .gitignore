# herdr runtime artifacts (regenerated at runtime; never commit)
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/herdr/*.sock
home/.config/herdr/.plugins.lock
home/.config/herdr/plugins.json
# GitHub-installed plugin code is Herdr runtime state. Plugin configuration is
# repository-authored and remains tracked under plugins/config/.
home/.config/herdr/plugins/github/
home/.config/herdr/plugins/state/
home/.config/herdr/release-notes.json

# macOS + nix build noise
.DS_Store
result
result-*

# Pi credentials and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# Legacy observational memory runtime state; never commit it
/.pi/om/

# Workflow run state is local runtime data; never commit it
/home/.pi/agent/workflow-runs/

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/

# Lavish review artifacts are local session state, not dotfiles
.lavish/
